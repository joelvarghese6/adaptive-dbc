# Copy to .env (local only, never commit) and fill in values.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptive
# METEORA_API_KEY=

# --- Adaptive DBC backend / devnet deployment ---
# Solana RPC endpoint. First end-to-end milestone targets devnet only.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Devnet wallet private key for server-side deployment demos.
# Accepts a base58 string OR a JSON byte array (e.g. output of `solana-keygen`).
# NEVER commit a real key. NEVER print this value.
SOLANA_PRIVATE_KEY=
# Port for @adaptive/api (Node http server).
PORT=4000
# Allowed CORS origin for the Next.js dev server.
WEB_ORIGIN=http://localhost:3000
# URL of @adaptive/api, consumed by the Next.js frontend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Optional devnet demo asset overrides ---
# 1B-token scale is the tested demo scale for feasible on-chain curves.
# ASSET_NAME=Adaptive Real Estate
# ASSET_SYMBOL=ARE
# ASSET_SUPPLY=1000000000
# ASSET_DECIMALS=9
# ASSET_REFERENCE_PRICE=0.001
# ASSET_TARGET_LIQUIDITY=100000
